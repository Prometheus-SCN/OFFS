/* Version resource for the Windows executables. MSI's file-overwrite rule
 * keeps an existing versioned file when the incoming one is unversioned, so
 * without this resource a machine that still has the old js-offs Electron
 * app installed keeps its offs.exe over ours. Generated per target by
 * CMake (configure_file) with the description and original filename filled
 * in; the numbers come from the top-level OFFS_VERSION_* variables. */

1 VERSIONINFO
 FILEVERSION @OFFS_VERSION_MAJOR@,@OFFS_VERSION_MINOR@,@OFFS_VERSION_PATCH@,0
 PRODUCTVERSION @OFFS_VERSION_MAJOR@,@OFFS_VERSION_MINOR@,@OFFS_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "OFFS"
      VALUE "FileDescription", "@OFFS_RC_DESCRIPTION@"
      VALUE "FileVersion", "@OFFS_VERSION@.0"
      VALUE "InternalName", "@OFFS_RC_TARGET@"
      VALUE "OriginalFilename", "@OFFS_RC_FILENAME@"
      VALUE "ProductName", "OFFS"
      VALUE "ProductVersion", "@OFFS_VERSION@.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END